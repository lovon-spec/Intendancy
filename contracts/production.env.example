# Production environment for DeployTimelock and DeployRegistry (launch-readiness sections 3 and 4).
# Copy to contracts/.env.production (gitignored), fill the values marked FILL, and never commit the copy.
# The deployer key pays gas only: it holds no role on the timelock and no role on the registry.

# --- both scripts ---
DEPLOYER_PRIVATE_KEY=FILL                     # the deployer EOA's key; forge reads it from the environment

# --- DeployTimelock (step 1 of deployment day) ---
TIMELOCK_PROPOSER=0x55705C596E087866C2B8e9339D7016b35a32619F   # the Safe: proposer and canceller
TIMELOCK_MIN_DELAY_SECONDS=604800             # seven days; the script refuses less outside tests

# --- DeployRegistry (step 2), production mode ---
DEPLOYMENT_MODE=production
GOVERNOR=FILL                                 # the timelock deployed in step 1, after verify-timelock.sh passes
GOVERNOR_PROPOSER=0x55705C596E087866C2B8e9339D7016b35a32619F   # the Safe; checked to hold the timelock's proposer and canceller roles and no admin role
MIN_JURORS=3                                  # court 19, three jurors: arbitration cost 21.6 xDAI today
REG_META_EVIDENCE=FILL                        # /ipfs/<cid>/registration-meta-evidence.json, pinned and gateway-checked
CLEAR_META_EVIDENCE=FILL                      # /ipfs/<cid>/clearing-meta-evidence.json, a different document
SUBMISSION_BASE_DEPOSIT_WEI=30000000000000000000
REMOVAL_BASE_DEPOSIT_WEI=30000000000000000000
SUBMISSION_CHALLENGE_BASE_DEPOSIT_WEI=0
REMOVAL_CHALLENGE_BASE_DEPOSIT_WEI=0
CHALLENGE_PERIOD_SECONDS=302400               # 3.5 days
SHARED_STAKE_MULTIPLIER_BPS=10000
WINNER_STAKE_MULTIPLIER_BPS=10000
LOSER_STAKE_MULTIPLIER_BPS=20000

# Run (from contracts/): forge script script/DeployTimelock.s.sol --rpc-url $GNOSIS_RPC_URL --broadcast
#                         forge script script/DeployRegistry.s.sol --rpc-url $GNOSIS_RPC_URL --broadcast
# Then take the registry address from the mined NewGTCR log in broadcast/DeployRegistry.s.sol/100/run-latest.json,
# never from the simulation, and verify its configuration on chain before publishing it.
