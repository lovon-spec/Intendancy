# What cli/tools/pin-wrapper.sh authenticates an Intendment wrapper against before it prints a
# profile table. Host, resolver and governor are not here: they are the profile's registry,
# arbitrator and governor. Update INTENDMENT_COMMIT if the factory is deployed from another commit.
INTENDMENT_COMMIT=092b2110c97d5652964eba1ab5a1665d4dcb4a78 # lovon-spec/intendment PR #22: the CREATE2 factory
HOST_PROFILE=1 # HostProfiles.Profile.Classic
CONFIG=86400,86400,86400,604800,86400 # window, funding period, resolver grace, reserve timelock, retirement margin
DEPLOYMENT=0 # the registry's first wrapper from that factory (salt counter n)
EPOCH=1 # the epoch the registry's envelope names
